<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.crossrealm.chronicles</groupId>
    <artifactId>crossrealm-chronicles-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>gateway</artifactId>
  <name>Crossrealm Chronicles :: Gateway（Spring Cloud Gateway）</name>
  <description>统一 API 网关 —— 对外唯一入口，按服务名负载均衡转发到各微服务</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
    </dependency>
    <!-- 按服务名解析路由（lb://）需要 discovery client -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
    </dependency>
    <!-- 网关熔断：lb 路由后端挂掉时返回 503 兜底而不是把空响应漏给调用方
         （spring-cloud-starter-circuitbreaker-reactor-resilience4j，版本由 spring-cloud-dependencies BOM 管理） -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-circuitbreaker-reactor-resilience4j</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Redis IP 限流（W-P10）：Spring Boot 自动配 LettuceConnectionFactory + ReactiveStringRedisTemplate；
         但端用默认 gateway.ratelimit.backend=memory，就不会真的连接 Redis —— 和 season-service 同一套纪律。
         激活 Redis 限流：SPRING_DATA_REDIS_HOST=… + gateway.ratelimit.backend=redis 。
         若 Redis 连不上：永不抛 — 记录 WARN 后退回内存计数，网关继续放行（限流 fail-open）。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
