# 环境变量样例 —— 这里**不放真值**。
# 用法：复制成 server/.env（compose 会自动读），或 `set -a; . ./.env; set +a` 后跑 mvn / node。
# 仓库根的 .env / .env.* 已被 .gitignore 忽略，任何密钥都不该进 git。
LLM_API_KEY=
LLM_BASE_URL=https://api.aizzz.xyz/v1
LLM_MODEL=gpt-6.2-sol
# 容器直连 api.aizzz.xyz 因 DNS / Cloudflare 边缘按地区拒（403）时，
# 指向宿主机上的 Clash 混合端口；ai-service 只让唯一出口 HttpLlmTransport 走 CONNECT 隧道。
# 示例（Linux Docker Desktop）：LLM_PROXY_URL=http://host.docker.internal:7897
LLM_PROXY_URL=
# 生产建议 false（冷启不自动铺上游前缀缓存；必要时手动 warmupUpstream）
LLM_WARMUP_ON_BOOT=false
# W-Z490：即使开了 warmup，大前缀车道（v4≈4.7万 / v5≈8.3万 tok）默认也不铺——
# 深潜低频，首问冷一次、次问即热，不值得每次开机烧十几万 token。真需要时设 true。
LLM_WARMUP_DEEP_LANES=false

# W-Y4 可靠任务队列旋钮（留空 = 用 ai-service/application.yml 的默认值）
AI_JOB_CAPACITY=64
AI_JOB_WORKERS=2
AI_JOB_MAX_ATTEMPTS=3
AI_JOB_RETRY_BASE_MS=200
AI_JOB_POLL_AFTER_MS=500
AI_JOB_MAX_TRACKED=512

# W-Z314 网关 XFF 信任开关（默认 false——不信任客户端 X-Forwarded-For）。
# 只有部署在受控反向代理/LB 之后、且 LB 会清掉客户端 XFF 并自己写第一跳时，才置 true。
# Spring relaxed binding：gateway.ratelimit.xff-trust → GATEWAY_RATELIMIT_XFFTRUST
GATEWAY_RATELIMIT_XFFTRUST=false
