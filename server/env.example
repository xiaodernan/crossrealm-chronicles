# 环境变量样例 —— 这里**不放真值**。
# 用法：复制成 server/.env（compose 会自动读），或 `set -a; . ./.env; set +a` 后跑 mvn / node。
# 仓库根的 .env / .env.* 已被 .gitignore 忽略，任何密钥都不该进 git。
LLM_API_KEY=
LLM_BASE_URL=https://wkapi.pro/v1
LLM_MODEL=gpt-6-sol

# W-Y4 可靠任务队列旋钮（留空 = 用 ai-service/application.yml 的默认值）
AI_JOB_CAPACITY=64
AI_JOB_WORKERS=2
AI_JOB_MAX_ATTEMPTS=3
AI_JOB_RETRY_BASE_MS=200
AI_JOB_POLL_AFTER_MS=500
AI_JOB_MAX_TRACKED=512
